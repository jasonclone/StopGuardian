<?xml version="1.0" encoding="UTF-8"?>
<!-- simulation/sumo/routes.rou.xml -->
<routes>
  <!-- Vehicles -->
  <vTypeDistribution id="vehDist">
    <vType
      id="car"
      vClass="passenger"
      length="4.8"
      accel="2.6"
      decel="4.5"
      maxSpeed="13.9"
      sigma="0.8"
      minGap="2.5"
      lcStrategic="1.0"
      lcCooperative="0.5"
      lcSpeedGain="1.0"
      lcKeepRight="0.7"
      lcRandom="0.3"
      probability="0.75"
    />
    <vType
      id="truck"
      vClass="truck"
      length="15.0"
      accel="1.2"
      decel="3.5"
      maxSpeed="11.1"
      sigma="0.7"
      minGap="3.5"
      lcStrategic="1.0"
      lcCooperative="0.2"
      lcSpeedGain="0.3"
      lcKeepRight="0.9"
      lcRandom="0.1"
      probability="0.10"
    />
    <vType
      id="bus"
      vClass="bus"
      length="12.0"
      accel="1.5"
      decel="3.5"
      maxSpeed="11.1"
      sigma="0.7"
      minGap="3.5"
      lcStrategic="1.0"
      lcCooperative="0.3"
      lcSpeedGain="0.2"
      lcKeepRight="0.8"
      lcRandom="0.05"
      probability="0.05"
    />
    <vType
      id="moto"
      vClass="motorcycle"
      length="2.2"
      accel="3.5"
      decel="4.0"
      maxSpeed="16.7"
      sigma="1.0"
      minGap="1.0"
      lcStrategic="1.0"
      lcCooperative="0.1"
      lcSpeedGain="1.5"
      lcKeepRight="0.2"
      lcRandom="0.8"
      probability="0.07"
    />
    <vType
      id="ev"
      vClass="emergency"
      length="6.5"
      accel="4.5"
      decel="4.5"
      maxSpeed="22.2"
      guishape="emergency"
      speedFactor="1.6"
      sigma="0.8"
      minGap="1.5"
      minGapLat="0.2"
      lcStrategic="1.0"
      lcCooperative="1.0"
      lcSpeedGain="2.0"
      lcKeepRight="0.0"
      lcRandom="0.2"
      probability="0.03"
    />
  </vTypeDistribution>

  <!-- vehicle routes (edges must match your network edges) -->
  <!-- North to x -->
  <route id="N_S" edges="N2C C2S" />
  <route id="N_E" edges="N2C C2E" />
  <route id="N_W" edges="N2C C2W" />

  <!-- South to x -->
  <route id="S_N" edges="S2C C2N" />
  <route id="S_E" edges="S2C C2E" />
  <route id="S_W" edges="S2C C2W" />

  <!-- East to x -->
  <route id="E_W" edges="E2C C2W" />
  <route id="E_N" edges="E2C C2N" />
  <route id="E_S" edges="E2C C2S" />

  <!-- West to x -->
  <route id="W_E" edges="W2C C2E" />
  <route id="W_N" edges="W2C C2N" />
  <route id="W_S" edges="W2C C2S" />

  <!-- Vehicle flows using vehicle type distribution -->
  <!-- North -->
  <flow id="north_straight" type="vehDist" route="N_S" begin="0" end="3600" probability="0.33" />
  <flow id="north_right" type="vehDist" route="N_E" begin="0" end="3600" probability="0.33" />
  <flow id="north_left" type="vehDist" route="N_W" begin="0" end="3600" probability="0.33" />
  <!-- South -->
  <flow id="south_straight" type="vehDist" route="S_N" begin="0" end="3600" probability="0.33" />
  <flow id="south_right" type="vehDist" route="S_E" begin="0" end="3600" probability="0.33" />
  <flow id="south_left" type="vehDist" route="S_W" begin="0" end="3600" probability="0.33" />
  <!-- East -->
  <flow id="east_straight" type="vehDist" route="E_W" begin="0" end="3600" probability="0.33" />
  <flow id="east_right" type="vehDist" route="E_N" begin="0" end="3600" probability="0.33" />
  <flow id="east_left" type="vehDist" route="E_S" begin="0" end="3600" probability="0.33" />
  <!-- West -->
  <flow id="west_straight" type="vehDist" route="W_E" begin="0" end="3600" probability="0.33" />
  <flow id="west_right" type="vehDist" route="W_N" begin="0" end="3600" probability="0.33" />
  <flow id="west_left" type="vehDist" route="W_S" begin="0" end="3600" probability="0.33" />

  <!-- Pedestrian -->
  <vType id="ped" vClass="pedestrian" speed="1.2" />

  <!-- Pedestrian flows using walk plans -->
  <!-- North → South (west crosswalk) -->
  <personFlow id="north_to_south_W" type="ped" begin="0" probability="0.05">
    <walk edges="Nside_W X_West Sside_W" />
  </personFlow>
  <!-- North → South (east crosswalk) -->
  <personFlow id="north_to_south_E" type="ped" begin="0" probability="0.05">
    <walk edges="Nside_E X_East Sside_E" />
  </personFlow>
  <!-- South → North (west crosswalk) -->
  <personFlow id="south_to_north_W" type="ped" begin="0" probability="0.05">
    <walk edges="Sside_W X_West Nside_W" />
  </personFlow>
  <!-- South → North (east crosswalk) -->
  <personFlow id="south_to_north_E" type="ped" begin="0" probability="0.05">
    <walk edges="Sside_E X_East Nside_E" />
  </personFlow>
  <!-- East → West (north crosswalk) -->
  <personFlow id="east_to_west_N" type="ped" begin="0" probability="0.05">
    <walk edges="Eside_N X_North Wside_N" />
  </personFlow>
  <!-- East → West (south crosswalk) -->
  <personFlow id="east_to_west_S" type="ped" begin="0" probability="0.05">
    <walk edges="Eside_S X_South Wside_S" />
  </personFlow>
  <!-- West → East (north crosswalk) -->
  <personFlow id="west_to_east_N" type="ped" begin="0" probability="0.05">
    <walk edges="Wside_N X_North Eside_N" />
  </personFlow>
  <!-- West → East (south crosswalk) -->
  <personFlow id="west_to_east_S" type="ped" begin="0" probability="0.05">
    <walk edges="Wside_S X_South Eside_S" />
  </personFlow>
</routes>
