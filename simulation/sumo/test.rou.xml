    />

    <vType
      id="ev"
      vClass="emergency"
      length="6.5"
      accel="4.5"
      decel="4.5"
      maxSpeed="22.2"
      speedFactor="1.6"
      sigma="0.8"
      minGap="1.5"
      speedDev="0.20"
      actionStepLength="0.5"
      lcStrategic="1.0"
      lcCooperative="1.0"
      lcSpeedGain="2.0"
      lcKeepRight="0.0"
      probability="0.0001"
    />
  </vTypeDistribution>

