<!--
  FHWA DATA SOURCES USED IN THIS FILE

  VEHICLE MIX (FHWA VM-1):
  https://www.fhwa.dot.gov/policyinformation/statistics/2023/vm1.cfm

  BICYCLE OPERATING CHARACTERISTICS (FHWA-HRT-04-103):
  https://www.fhwa.dot.gov/publications/research/safety/04103/07.cfm

  PEDESTRIAN WALKING SPEEDS (FHWA-HRT-05-100):
  https://www.fhwa.dot.gov/publications/research/safety/pedbike/05085/pptchapt8.cfm

  NOTES:
  - Applied Urban America tuning: car sigma reduced to 0.5, minGap to 2.0,
    jmDriveAfterRedTime added for realistic aggressive behavior.
  - Replaced high deterministic perHour/car bursts with per-second Poisson-like
    probabilities for turning splits (straight/left/right).
  - All flows spawn at edge start (departPos="0"), use departLane="best",
    and departSpeed="random" for realistic entry speeds.
  - Removed any attributes that are invalid for <vType> in SUMO schema.
-->

<routes
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd"
