<?xml version="1.0" encoding="UTF-8"?>
<!-- simulation/sumo/simulation.sumocfg -->
<configuration>
  <input>
    <net-file value="intersection.net.xml"/>
    <!-- change route file to choose demand scenario-->
    <route-files value="routes.rou.xml"/>
    <tripinfo-output value="../../results/tripinfo.xml"/>
    <additional-files value="tls.add.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="3600"/>
  </time>
</configuration>
